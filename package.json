{
  "name": "ava-addon-create",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Create: an infinite design canvas where Ava builds HTML/CSS artboards with tools, as an Ava add-on. `npm run build` writes the add-on's bundle to dist/. Its version is public/manifest.json's, nowhere else.",
  "repository": "https://github.com/addiscorp/ava-create",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@fontsource/comfortaa": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@modelcontextprotocol/ext-apps": "2.1.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "linkedom": "0.18.15",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
